{
  "name": "sensepilot",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/ui/renderer.js && node --check src/file-processing.cjs && node --check src/image-analysis.js && node --check src/health.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:mac:arm64": "electron-builder --mac dmg --arm64 --publish never",
    "build:mac:x64": "electron-builder --mac dmg --x64 --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "src/main.cjs",
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.sensepilot.desktop",
    "productName": "SensePilot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/transcribe.py",
        "to": "scripts/transcribe.py"
      },
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
